import java.util.HashSet;
import java.util.Set;

class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        // Use a HashSet to act as our sliding window of size k
        Set<Integer> window = new HashSet<>();
        
        for (int i = 0; i < nums.length; i++) {
            // If the current number is already in the window, we found our duplicate
            if (window.contains(nums[i])) {
                return true;
            }
            
            // Add the current number to the window
            window.add(nums[i]);
            
            // If the window size exceeds k, remove the oldest element
            if (window.size() > k) {
                window.remove(nums[i - k]);
            }
        }
        
        // If we finish the loop without finding a duplicate, return false
        return false;
    }
}
